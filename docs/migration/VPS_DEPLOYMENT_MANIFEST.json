{
  "$comment": "Machine-readable Windows VPS deployment contract for the H&C tearsheet system. Contains NO credentials. Generated for HC_APP_ENV=vps-production. Paths are the canonical C:\\H&C layout resolved by tearsheet_paths.py; laptop defaults are reproduced exactly when HC_APP_ENV is unset.",
  "schema_version": "1.0.0",
  "app_env": "vps-production",
  "canonical_root": "C:\\H&C",
  "provider_neutral": true,
  "apps": {
    "root": "C:\\H&C\\apps",
    "tkp": "C:\\H&C\\apps\\tkp",
    "tcp": "C:\\H&C\\apps\\tcp",
    "agm": "C:\\H&C\\apps\\agm",
    "yq": "C:\\H&C\\apps\\yq",
    "dashboard": "C:\\H&C\\apps\\dashboard",
    "shared": "C:\\H&C\\apps\\shared"
  },
  "data": {
    "root": "C:\\H&C\\data",
    "tkp": "C:\\H&C\\data\\tkp",
    "tcp": "C:\\H&C\\data\\tcp",
    "agm": "C:\\H&C\\data\\agm",
    "yq": "C:\\H&C\\data\\yq"
  },
  "config": {
    "root": "C:\\H&C\\config"
  },
  "secrets": {
    "root": "C:\\H&C\\secrets",
    "policy": "No secret values are stored here in Git. Injected at deploy time via NSSM service environment or read from this directory at runtime."
  },
  "logs": {
    "root": "C:\\H&C\\logs",
    "tkp": "C:\\H&C\\logs\\tkp",
    "tcp": "C:\\H&C\\logs\\tcp",
    "agm": "C:\\H&C\\logs\\agm",
    "yq": "C:\\H&C\\logs\\yq",
    "dashboard": "C:\\H&C\\logs\\dashboard",
    "ingest": "C:\\H&C\\logs\\ingest"
  },
  "backups": {
    "root": "C:\\H&C\\backups",
    "tkp": "C:\\H&C\\backups\\tkp",
    "tcp": "C:\\H&C\\backups\\tcp",
    "agm": "C:\\H&C\\backups\\agm",
    "yq": "C:\\H&C\\backups\\yq"
  },
  "website": {
    "root": "C:\\H&C\\website"
  },
  "deployment": {
    "root": "C:\\H&C\\deployment"
  },
  "ports": {
    "dashboard": 8006,
    "tkp_public": 8301,
    "tcp_public": 8302,
    "yq_public": 8303,
    "agm_public": 8304,
    "tkp_staff": 8321,
    "tcp_staff": 8322,
    "agm_staff": 8324
