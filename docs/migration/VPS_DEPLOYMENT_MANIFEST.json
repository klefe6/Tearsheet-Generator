      "port": 8304,
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "log_dir": "C:\\H&C\\logs\\agm"
    },
    "tkp_staff": {
      "app_dir": "C:\\H&C\\apps\\tkp",
      "working_directory": "C:\\H&C\\apps\\tkp",
      "script": "tkp_ts.py",
      "port": 8321,
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "log_dir": "C:\\H&C\\logs\\tkp"
    },
    "tcp_staff": {
      "app_dir": "C:\\H&C\\apps\\tcp",
      "working_directory": "C:\\H&C\\apps\\tcp",
      "script": "tcp_ts_v2.py",
      "port": 8322,
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "log_dir": "C:\\H&C\\logs\\tcp"
    },
    "agm_staff": {
      "app_dir": "C:\\H&C\\apps\\agm",
      "working_directory": "C:\\H&C\\apps\\agm\\Momentum Pacer",
      "script": "mp_ts.py",
      "port": 8324,
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "log_dir": "C:\\H&C\\logs\\agm"
    },
    "dashboard": {
      "app_dir": "C:\\H&C\\apps\\dashboard",
      "working_directory": "C:\\H&C\\apps\\dashboard",
      "script": "TBD (Manager landing app, external to this repo)",
      "port": 8006,
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "log_dir": "C:\\H&C\\logs\\dashboard",
      "note": "Dashboard/launcher currently lives in the external Manager repo and was intentionally not modified in this phase."
    }
  },
  "environment_variables": {
    "profile_selector": "HC_APP_ENV=vps-production",
    "roots": {
      "HC_APPS_ROOT": "C:\\H&C\\apps",
      "HC_DATA_ROOT": "C:\\H&C\\data",
      "HC_CONFIG_ROOT": "C:\\H&C\\config",
