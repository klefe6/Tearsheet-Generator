  "services": {
    "$comment": "Predictable inputs for future NSSM service definitions. This phase does NOT create services. working_directory is the app dir; data lives separately under data\\. No NSSM/IIS/Cloudflare changes are performed here.",
    "tkp_public": {
      "app_dir": "C:\\H&C\\apps\\tkp",
      "working_directory": "C:\\H&C\\apps\\tkp",
      "script": "tkp_ts.py",
      "port": 8301,
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "log_dir": "C:\\H&C\\logs\\tkp"
    },
    "tcp_public": {
      "app_dir": "C:\\H&C\\apps\\tcp",
      "working_directory": "C:\\H&C\\apps\\tcp",
      "script": "tcp_ts_v2.py",
      "port": 8302,
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "log_dir": "C:\\H&C\\logs\\tcp"
    },
    "yq_public": {
      "app_dir": "C:\\H&C\\apps\\yq",
      "working_directory": "C:\\H&C\\apps\\yq",
      "script": "yq_ts.py",
      "port": 8303,
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "log_dir": "C:\\H&C\\logs\\yq"
    },
    "agm_public": {
      "app_dir": "C:\\H&C\\apps\\agm",
