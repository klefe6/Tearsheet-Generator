    },
    "secret_env_keys_no_values": [
      "TCP_V2_ADMIN_TOKEN",
      "TCP_V2_SESSION_SECRET"
    ],
    "note": "All root/data keys are optional on VPS because HC_APP_ENV=vps-production supplies them as profile defaults. They are listed for explicitness and for operators who prefer per-key configuration."
