{
  "schema_version": "1.0.0",
  "description": "Future Windows service contracts for NSSM. Services are NOT created in this phase.",
  "startup_mode": "automatic",
  "restart_expectation": "restart_on_failure",
  "bind_address": "127.0.0.1",
  "cloudflare_tunnel": "parallel tunnel to localhost ports (future phase)",
  "iis_arr": "optional reverse proxy in front of localhost (future phase)",
  "services": [
    {
      "service_name": "HC-TKP-Public",
      "application": "tkp",
      "role": "public",
      "port": 8301,
      "executable": "python.exe",
      "script": "tkp_ts.py",
      "working_directory": "C:\\HC\\apps\\tkp",
      "log_directory": "C:\\HC\\logs\\tkp",
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "public_bind": false,
      "notes": "Bind loopback; expose via Cloudflare Tunnel / IIS ARR only."
    },
    {
      "service_name": "HC-TCP-Public",
      "application": "tcp",
      "role": "public",
      "port": 8302,
      "executable": "python.exe",
      "script": "tcp_ts_v2.py",
      "working_directory": "C:\\HC\\apps\\tcp",
      "log_directory": "C:\\HC\\logs\\tcp",
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "public_bind": false
    },
    {
      "service_name": "HC-YQ-Public",
      "application": "yq",
      "role": "public",
      "port": 8303,
      "executable": "python.exe",
      "script": "yq_ts.py",
      "working_directory": "C:\\HC\\apps\\yq",
      "log_directory": "C:\\HC\\logs\\yq",
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "public_bind": false
    },
    {
      "service_name": "HC-AGM-Public",
      "application": "agm",
      "role": "public",
      "port": 8304,
      "executable": "python.exe",
      "script": "mp_ts.py",
      "working_directory": "C:\\HC\\apps\\agm\\Momentum Pacer",
      "log_directory": "C:\\HC\\logs\\agm",
      "env_profile": "vps-production",
      "runtime_mode": "public",
      "public_bind": false
    },
    {
      "service_name": "HC-TKP-Staff",
      "application": "tkp",
      "role": "staff",
      "port": 8321,
      "executable": "python.exe",
      "script": "tkp_ts.py",
      "working_directory": "C:\\HC\\apps\\tkp",
      "log_directory": "C:\\HC\\logs\\tkp",
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "public_bind": false,
      "cloudflare_access": "required"
    },
    {
      "service_name": "HC-TCP-Staff",
      "application": "tcp",
      "role": "staff",
      "port": 8322,
      "executable": "python.exe",
      "script": "tcp_ts_v2.py",
      "working_directory": "C:\\HC\\apps\\tcp",
      "log_directory": "C:\\HC\\logs\\tcp",
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "public_bind": false,
      "cloudflare_access": "required"
    },
    {
      "service_name": "HC-AGM-Staff",
      "application": "agm",
      "role": "staff",
      "port": 8324,
      "executable": "python.exe",
      "script": "mp_ts.py",
      "working_directory": "C:\\HC\\apps\\agm\\Momentum Pacer",
      "log_directory": "C:\\HC\\logs\\agm",
      "env_profile": "vps-production",
      "runtime_mode": "staff",
      "public_bind": false,
      "cloudflare_access": "required"
    },
    {
      "service_name": "HC-Dashboard",
      "application": "dashboard",
      "role": "internal",
      "port": 8006,
      "executable": "python.exe",
      "script": "TBD (Manager repo launcher)",
      "working_directory": "C:\\HC\\apps\\dashboard",
      "log_directory": "C:\\HC\\logs\\dashboard",
      "env_profile": "vps-production",
      "runtime_mode": "internal",
      "public_bind": false,
      "notes": "Internal operator dashboard only — do not expose publicly without explicit approval."
    }
  ]
}
