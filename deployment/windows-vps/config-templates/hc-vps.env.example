# Hughes & Company — Windows VPS environment template
#
# DO NOT COMMIT A POPULATED VERSION OF THIS FILE
#
# Copy to the VPS as hc-vps.env (or inject via NSSM service environment)
# and fill in secret placeholders only on the server. Never commit real values.

# --- Profile selector (required on VPS) ---
HC_APP_ENV=vps-production

# --- Layout roots (optional — vps-production profile supplies these defaults) ---
HC_APPS_ROOT=C:\H&C\apps
HC_DATA_ROOT=C:\H&C\data
HC_PRODUCTION_DATA_ROOT=C:\H&C\data
HC_SANDBOX_DATA_ROOT=C:\H&C\data\sandbox
HC_CONFIG_ROOT=C:\H&C\config
HC_SECRETS_ROOT=C:\H&C\secrets
HC_LOG_ROOT=C:\H&C\logs
HC_CACHE_ROOT=C:\H&C\data
HC_BACKUP_ROOT=C:\H&C\backups
HC_WEBSITE_ROOT=C:\H&C\website
HC_DEPLOY_ROOT=C:\H&C\apps\shared

# --- Per-program data roots ---
HC_TKP_DATA_ROOT=C:\H&C\data\tkp
HC_TCP_DATA_ROOT=C:\H&C\data\tcp
HC_AGM_DATA_ROOT=C:\H&C\data\agm
HC_YQ_DATA_ROOT=C:\H&C\data\yq

# --- TKP persistent files ---
HC_TKP_STATE_PATH=C:\H&C\data\tkp\daily_returns_secret_state.json
HC_TKP_SOURCE_WORKBOOK=C:\H&C\data\tkp\tkp_source_workbook.xlsx

# --- TCP persistent files / config ---
TCP_V2_WORKBOOK_PATH=C:\H&C\data\tcp\tcp_alex.xlsx
TCP_V2_STATE_PATH=C:\H&C\data\tcp\tcp_daily_returns_secret_state.json
TCP_V2_STATE_BACKUP_PATH=C:\H&C\data\tcp\tcp_daily_returns_secret_state.backup.json
TCP_V2_STATE_LOCK_PATH=C:\H&C\data\tcp\tcp_daily_returns_secret_state.lock
TCP_V2_STATE_MODE=json_active
TCP_V2_BIND_PORT=8302
TCP_V2_BENCHMARK_CACHE_PATH=C:\H&C\data\tcp\_runtime\tcp_benchmark_cache.json

# --- AGM persistent files ---
HC_AGM_MANUAL_STATE_PATH=C:\H&C\data\agm\momentum_pacer_manual_daily_rows.json
HC_AGM_FEE_WORKBOOK=C:\H&C\data\agm\Momentum Fee Calculation.xlsx
HC_AGM_PINNED_CSV=C:\H&C\data\agm\data\daily_balances\balances_210TGG51_20OCT2025_07JUL2026.csv
HC_AGM_BENCHMARK_CACHE_DIR=C:\H&C\data\agm\data\benchmarks

# --- Y&Q persistent files ---
YQ_CSV_PATH=C:\H&C\data\yq\yq.csv

# --- Ingest audit logs (append-only) ---
HC_TCP_INGEST_AUDIT_PATH=C:\H&C\logs\ingest\glenn_uploader_ingest_tcp_audit.jsonl
HC_AGM_INGEST_AUDIT_PATH=C:\H&C\logs\ingest\glenn_uploader_ingest_agm_audit.jsonl

# --- Runtime mode / ports (public services) ---
TEARSHEET_MODE=public
TKP_BIND_PORT=8301
AGM_BIND_PORT=8304

# --- Secret variables (NAMES ONLY — set values on the VPS, never commit) ---
TCP_V2_ADMIN_TOKEN=
TCP_V2_SESSION_SECRET=

# TKP/AGM staff admin secrets (if not using shared sibling defaults):
# TKP_ADMIN_TOKEN=
# TKP_SESSION_SECRET=
# AGM_ADMIN_TOKEN=
# AGM_SESSION_SECRET=
