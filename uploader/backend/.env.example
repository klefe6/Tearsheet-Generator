# Glenn Daily Uploader — backend configuration (SAFE PLACEHOLDERS)
# Copy to `.env` and adjust. Never commit a real `.env` (it is gitignored).

# ----------------------------------------------------------------------------
# Environment: "sandbox" (local dev, relaxed auth, dry-run only) or "production"
APP_ENV=sandbox

# Master switch for REAL exports. Leave false. Even when true, this build does
# NOT call the TKP/TCP/AGM/Y&Q websites (external transport is not implemented).
EXPORT_ENABLED=false

# Local SQLite file used for sandbox/local storage (relative to backend/).
# (A full DATABASE_URL is a future extension; a local file path is enough now.)
DATABASE_PATH=data/uploader_sandbox.db

# Simple bearer token required for mutations in PRODUCTION.
# In sandbox this is optional (auth is intentionally relaxed for local dev).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Comma-separated list of allowed frontend origins (CORS).
# Include local dev origins plus future public frontend URLs.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://uploader-sandbox.hcresearch.ltd,https://uploader.hcresearch.ltd

# ----------------------------------------------------------------------------
# FUTURE export targets. Read only so they can be shown in the export preview.
# This build NEVER issues a request to any of them. Leave blank for now.
EXPORT_URL_TKP=
EXPORT_URL_TCP=
EXPORT_URL_AGM=
EXPORT_URL_YQ=

# ----------------------------------------------------------------------------
# Downstream export (TKP/TCP/AGM sandbox destinations). See
# docs/downstream_export_contract.md. All default to the safest value.
# Y&Q always reports "skipped" — it has no destination in this build.

# Master switch for this feature. false => /api/export/all behaves exactly as
# it did before this feature existed (uploader-only preview only).
EXPORT_DOWNSTREAM_ENABLED=false

# Even with the master switch on, still just compute + report; write nothing.
EXPORT_DRY_RUN=true

# "sandbox" (local files this backend owns) or "production" (the real
# TKP/TCP/AGM sites). Production transport is NOT IMPLEMENTED in this build —
# selecting it always yields a "failure" result per row, by construction.
EXPORT_TARGET_ENV=sandbox

# Forward-compatible only — Y&Q has no destination yet regardless of this.
EXPORT_INCLUDE_YQ=false

# Directory (relative to backend/) holding the sandbox destination files.
DOWNSTREAM_SANDBOX_DIR=data/downstream_sandbox

# Directory (relative to backend/) holding CSV daily-close caches for SPX/NDX/BTC.
BENCHMARK_CACHE_DIR=data/benchmark_cache
# Set to 1 to forbid yfinance network calls (use cache files only).
# BENCHMARK_CACHE_ONLY=0

# Bearer token this backend would send to a real production downstream
# endpoint (does not exist yet). Never set in sandbox.
DOWNSTREAM_API_TOKEN=
