# Sandbox environment (used by `npm run dev` and `npm run build:sandbox`).
# No secrets here — just non-production wiring. Safe to commit.
# For local backend on :8091, copy `.env.local.example` to `.env.local` (git-ignored).
VITE_APP_ENV=sandbox
VITE_API_BASE_URL=https://uploader-sandbox.hcresearch.ltd/api
