{
  "name": "glenn-daily-uploader-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for the Glenn Daily Uploader — daily NLV / cash / fee entry for TKP, TCP, AGM and Y&Q.",
  "scripts": {
    "dev": "vite --mode sandbox",
    "dev:prod": "vite --mode production",
    "build": "tsc --noEmit && vite build",
    "build:sandbox": "tsc --noEmit && vite build --mode sandbox",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
