# Copy of the environment contract this app reads. Vite loads `.env.<mode>`
# automatically (mode = "sandbox" for `npm run dev`, "production" for `npm run build`).
# To override locally without touching the committed files, create `.env.local`.

# Which environment this build targets. Drives only the on-screen env badge today.
VITE_APP_ENV=sandbox

# Base URL of the uploader backend API. Reserved for the future export wiring —
# not called by this frontend-only build.
# Public URLs: sandbox → https://uploader-sandbox.hcresearch.ltd/api
#              production → https://uploader.hcresearch.ltd/api
# Local dev override (`.env.local`): http://localhost:8090/api
VITE_API_BASE_URL=https://uploader-sandbox.hcresearch.ltd/api
